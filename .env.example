# --- Database ---
# For quick local testing, leave as sqlite (no setup needed):
DATABASE_URL=sqlite:///./app.db
# For production, use PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_company

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Seed / bootstrap admin account (auto-created on first run) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- CORS ---
# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://app.example.com
# Defaults to "*" for local dev — set this explicitly before deploying.
ALLOWED_ORIGINS=*
