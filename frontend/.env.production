# Used automatically by `npm run build` (Vite's production mode).
#
# This default (/api) assumes the self-hosted nginx setup in deploy/,
# where nginx serves this frontend and reverse-proxies /api/* to the
# backend on the SAME domain — see DEPLOYMENT.md "Option B".
#
# Deploying frontend and backend to DIFFERENT domains (e.g. Vercel +
# Railway — DEPLOYMENT.md "Option A")? Override this by setting
# VITE_API_URL to your backend's full URL as an environment variable in
# your hosting platform's dashboard (Vercel/Netlify env vars set at build
# time take priority over this file).
VITE_API_URL=/api
